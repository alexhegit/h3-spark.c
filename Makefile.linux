# Linux / CUDA build for DGX Spark (h3-cuda Phase 0).
# Usage: make -f Makefile.linux [target]

CC := gcc
NVCC := /usr/local/cuda/bin/nvcc
CUDA_LIB := /usr/local/cuda/lib64

CFLAGS := -std=c11 -O2 -Wall -Wextra -Wpedantic -MMD -MP -I. -Ithird_party -D_GNU_SOURCE \
	-I/usr/local/cuda/include
NVCCFLAGS := -std=c++17 -O2 -Xcompiler -fPIC -I. \
	-gencode arch=compute_121,code=sm_121
LDFLAGS := -L$(CUDA_LIB) -Wl,-rpath,$(CUDA_LIB) -lcudart -lcublas \
	-lstdc++ -licuuc -lm -pthread

LIB_C := h3.c h3_host.c h3_safetensors.c h3_weights.c h3_text_encoder.c \
	h3_dit_schedule.c h3_dit.c h3_video_vae.c h3_video_encoder.c \
	h3_audio_vae.c h3_ffmpeg.c h3_terminal.c h3_vision_encoder.c \
	h3_multimodal.c h3_device.c h3_cuda.c h3_tokenizer.c third_party/cJSON.c

LIB_CUDA := h3_gpu.cu h3_gpu_stubs.c

LIB_OBJ := $(LIB_C:.c=.o) h3_gpu.o h3_gpu_stubs.o
CLI_OBJ := main.o h3_cli.o linenoise.o

.PHONY: all test test-step test-conditional smoke probe clean tokenizer_test tokenizer_smoke

all: h3

h3: $(CLI_OBJ) $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

libh3_cuda.a: $(LIB_OBJ)
	ar rcs $@ $^

h3_tests: tests/test_h3.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_smoke: tests/test_cuda_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_probe: tools/h3_cuda_probe.o h3_cuda.o
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_ops: tests/test_cuda_ops.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_dit_block_smoke: tests/test_cuda_dit_block_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_text_smoke: tests/test_cuda_text_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_vision_smoke: tests/test_cuda_vision_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_dit_forward_smoke: tests/test_cuda_dit_forward_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_video_vae_smoke: tests/test_cuda_video_vae_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_audio_vae_smoke: tests/test_cuda_audio_vae_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_video_encoder_smoke: tests/test_cuda_video_encoder_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

h3_cuda_audio_encoder_smoke: tests/test_cuda_audio_encoder_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

# Requires MiniMax-H3/tokenizer/tokenizer.json (or pass path as argv[1]).
tokenizer_test: tests/test_tokenizer.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

tokenizer_smoke: tests/test_tokenizer_smoke.o $(LIB_OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

test: h3_tests h3_cuda_smoke h3_cuda_ops
	./h3_tests
	./h3_cuda_smoke
	./h3_cuda_ops
	@$(MAKE) -f Makefile.linux h3_cuda_dit_block_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_block_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_block_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: DiT block smoke (transformer weights not available)"; \
	fi
	@$(MAKE) -f Makefile.linux h3_cuda_text_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/text_encoder/config.json; then \
		./h3_cuda_text_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/text_encoder/config.json; then \
		./h3_cuda_text_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: text encoder smoke (weights not available)"; \
	fi
	@$(MAKE) -f Makefile.linux h3_cuda_vision_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/text_encoder/config.json; then \
		./h3_cuda_vision_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/text_encoder/config.json; then \
		./h3_cuda_vision_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: vision encoder smoke (weights not available)"; \
	fi
	@if test -f MiniMax-H3/tokenizer/tokenizer.json || test -n "$$H3_TOKENIZER_JSON"; then \
		$(MAKE) -f Makefile.linux tokenizer_smoke; \
		path=$${H3_TOKENIZER_JSON:-MiniMax-H3/tokenizer/tokenizer.json}; \
		./tokenizer_smoke $$path; \
	else \
		echo "skip: tokenizer JSON not available"; \
	fi
	@$(MAKE) -f Makefile.linux h3_cuda_video_vae_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/video_vae/source/config.json; then \
		./h3_cuda_video_vae_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/video_vae/source/config.json; then \
		./h3_cuda_video_vae_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: video VAE smoke (weights not available)"; \
	fi
	@$(MAKE) -f Makefile.linux h3_cuda_audio_vae_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/audio_vae/config.json -o -f $$path/FL2VA/audio_vae/model.safetensors; then \
		./h3_cuda_audio_vae_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/audio_vae/config.json -o -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/audio_vae/model.safetensors; then \
		./h3_cuda_audio_vae_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: audio VAE smoke (weights not available)"; \
	fi
	@$(MAKE) -f Makefile.linux h3_cuda_video_encoder_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/video_vae/source/config.json; then \
		./h3_cuda_video_encoder_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/video_vae/source/config.json; then \
		./h3_cuda_video_encoder_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: video encoder smoke (weights not available)"; \
	fi
	@$(MAKE) -f Makefile.linux h3_cuda_audio_encoder_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/audio_vae/model.safetensors; then \
		./h3_cuda_audio_encoder_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/audio_vae/model.safetensors; then \
		./h3_cuda_audio_encoder_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: audio encoder smoke (weights not available)"; \
	fi

# FL2VA first/last + Ref2VA image/audio/silent (~15–25 min). Skips long --ref-video
# by default; H3_CONDITIONAL_SKIP_REF_VIDEO=0 includes 72-frame embedded audio ref.
test-conditional: h3
	@chmod +x scripts/smoke_conditional.sh
	@H3_CONDITIONAL_SKIP_REF_VIDEO=$${H3_CONDITIONAL_SKIP_REF_VIDEO:-1}; \
	export H3_CONDITIONAL_SKIP_REF_VIDEO; \
	path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/transformer/config.json; then \
		./scripts/smoke_conditional.sh $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/transformer/config.json; then \
		./scripts/smoke_conditional.sh /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: conditional smoke (weights not available)"; \
	fi

test-step: h3_cuda_dit_block_smoke h3_cuda_text_smoke h3_cuda_dit_forward_smoke
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_block_smoke $$path full; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_block_smoke /home/alex/HF-MODELS/MiniMax-H3 full; \
	else \
		echo "skip: DiT step smoke (transformer weights not available)"; \
	fi
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/text_encoder/config.json; then \
		./h3_cuda_text_smoke $$path full; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/text_encoder/config.json; then \
		./h3_cuda_text_smoke /home/alex/HF-MODELS/MiniMax-H3 full; \
	else \
		echo "skip: text encoder full smoke (weights not available)"; \
	fi
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_forward_smoke $$path; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_forward_smoke /home/alex/HF-MODELS/MiniMax-H3; \
	else \
		echo "skip: DiT forward smoke (transformer weights not available)"; \
	fi
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_forward_smoke $$path full; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_forward_smoke /home/alex/HF-MODELS/MiniMax-H3 full; \
	else \
		echo "skip: DiT forward full smoke (transformer weights not available)"; \
	fi
	@path=$${H3_MODEL_ROOT:-MiniMax-H3}; \
	if test -f $$path/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_forward_smoke $$path int8; \
	elif test -f /home/alex/HF-MODELS/MiniMax-H3/FL2VA/transformer/config.json; then \
		./h3_cuda_dit_forward_smoke /home/alex/HF-MODELS/MiniMax-H3 int8; \
	else \
		echo "skip: DiT INT8 forward smoke (transformer weights not available)"; \
	fi

smoke: h3_cuda_smoke
	./h3_cuda_smoke

probe: h3_cuda_probe
	./h3_cuda_probe

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

h3_gpu.o: h3_gpu.cu
	$(NVCC) $(NVCCFLAGS) -c $< -o $@

h3_gpu_stubs.o: h3_gpu_stubs.c
	$(CC) $(CFLAGS) -c $< -o $@

tests/%.o: tests/%.c
	$(CC) $(CFLAGS) -c $< -o $@

tools/%.o: tools/%.c
	$(CC) $(CFLAGS) -c $< -o $@

linenoise.o: CFLAGS += -Wno-conversion

-include $(wildcard *.d tests/*.d tools/*.d)

clean:
	rm -f h3 h3_tests h3_cuda_smoke h3_cuda_ops h3_cuda_dit_block_smoke \
		h3_cuda_text_smoke h3_cuda_vision_smoke h3_cuda_dit_forward_smoke \
		h3_cuda_video_vae_smoke h3_cuda_audio_vae_smoke \
		h3_cuda_video_encoder_smoke h3_cuda_audio_encoder_smoke \
		h3_cuda_probe libh3_cuda.a \
		tokenizer_test tokenizer_smoke \
		*.o *.d tests/*.o tests/*.d tools/*.o tools/*.d third_party/*.o third_party/*.d
